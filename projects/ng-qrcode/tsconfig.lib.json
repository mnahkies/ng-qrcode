{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/lib",
    "declarationMap": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "types": []
  },
  "angularCompilerOptions": {
    "skipTemplateCodegen": true,
    "strictMetadataEmit": true,
    "fullTemplateTypeCheck": true,
    "strictInjectionParameters": true,
    "enableResourceInlining": true
  },
  "include": [
    "./src/**/*.ts"
  ],
  "exclude": [
    "./src/test.ts",
    "./src/**/*.spec.ts"
  ]
}
