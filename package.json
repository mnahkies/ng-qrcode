{
  "name": "ng-qrcode",
  "private": true,
  "version": "0.0.0",
  "author": {
    "name": "Michael Nahkies",
    "email": "support@nahkies.co.nz"
  },
  "license": "MIT",
  "description": "Simple AOT compatible QR code generator for your Angular project.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mnahkies/ng-qrcode.git"
  },
  "bugs": {
    "url": "https://github.com/mnahkies/ng-qrcode/issues"
  },
  "scripts": {
    "prepare": "husky",
    "sync:packageManagerVersion": "pnpm dlx corepack use pnpm@$(mise tool pnpm -J | jq -r '.requested_versions[0]')",
    "clean": "rm -rf ./dist ./coverage",
    "docs:generate": "node ./scripts/generate-toc.mjs",
    "start": "ng serve",
    "build": "ng build --project ng-qrcode --configuration production",
    "build-for-publish": "ng build --project ng-qrcode --configuration production && pnpm run copy:docs",
    "build-demo-app": "ng build --project=ng-qrcode-demo --configuration production --base-href '/ng-qrcode/'",
    "publish:gh-pages": "pnpm run build-demo-app && pnpm exec gh-pages -d ./dist/ng-qrcode-demo/browser -b gh-pages --nojekyll",
    "test": "ng test --watch false",
    "lint": "ng lint",
    "ci-pipeline": "pnpm run clean && pnpm run ci-build && pnpm run ci-test && pnpm run ci-lint && pnpm run copy:docs",
    "copy:docs": "cp ./README.md ./CHANGES.md ./LICENSE ./dist/ng-qrcode/",
    "ci-build": "ng build --project ng-qrcode --configuration production && ng build --project=ng-qrcode-demo --configuration production",
    "ci-test": "ng test --watch false --coverage",
    "ci-lint": "ng lint"
  },
  "dependencies": {
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/router": "^22.0.1",
    "qrcode": "^1.5.4",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/schematics": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@angular/language-service": "^22.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.21",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "@vitest/coverage-v8": "^4.1.8",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.4.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "ng-packagr": "^22.0.0",
    "remark": "^15.0.1",
    "remark-toc": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.md": [
      "sh -c 'pnpm run docs:generate'"
    ]
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
